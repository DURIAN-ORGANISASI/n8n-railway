# Local Docker Compose only. Copy to .env and fill in real values.
# Never commit .env or paste real secrets into public issues.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

N8N_PORT=5678
# Generate with scripts/generate-key.ps1 (Windows) or scripts/generate-key.sh (Linux/macOS).
N8N_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_64_CHARACTER_HEX_KEY
TZ=Asia/Jakarta
